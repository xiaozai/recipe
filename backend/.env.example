# ===========================================
# LLM API 配置 (支持 Anthropic 和 OpenAI 格式)
# ===========================================

# API 密钥 (必填)
API_KEY=your_api_key_here

# API 基础 URL (可选，有默认值)
# Anthropic: https://api.anthropic.com
# OpenAI: https://api.openai.com/v1
# 自定义服务: https://your-custom-service.com/v1
BASE_URL=https://api.anthropic.com

# 模型名称 (必填)
# Anthropic: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5
# OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
MODEL_NAME=claude-sonnet-4-6

# API 类型: anthropic 或 openai (默认: anthropic)
API_TYPE=anthropic


# ===========================================
# 其他 API Keys
# ===========================================

# GitHub Token (可选，提高 GitHub API 限制)
GITHUB_TOKEN=your_github_token

# Reddit API (可选)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Twitter API (可选)
TWITTER_BEARER_TOKEN=your_twitter_token


# ===========================================
# 数据库配置 (可选)
# ===========================================

DATABASE_URL=postgresql://user:password@localhost:5432/trend_analyzer
REDIS_URL=redis://localhost:6379/0


# ===========================================
# 应用设置
# ===========================================

APP_NAME=Tech Trend Analyzer
DEBUG=true
LOG_LEVEL=INFO


# ===========================================
# 示例配置
# ===========================================

# 使用 Anthropic Claude:
# API_KEY=sk-ant-xxx
# BASE_URL=https://api.anthropic.com
# MODEL_NAME=claude-sonnet-4-6
# API_TYPE=anthropic

# 使用 OpenAI GPT:
# API_KEY=sk-xxx
# BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4-turbo
# API_TYPE=openai

# 使用自定义 OpenAI 兼容服务 (如 DeepSeek, 智谱等):
# API_KEY=your_custom_key
# BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat
# API_TYPE=openai

# 使用本地 Ollama:
# API_KEY=ollama
# BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama2
# API_TYPE=openai